# ─────────────────────────────────────────────────────────────────────────────
# Datenmonster – Konfigurationsvorlage
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Ports ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=5174
BACKEND_PORT=8000

# ─── Sicherheit ───────────────────────────────────────────────────────────────
# Zufälligen langen String generieren: openssl rand -hex 32
SECRET_KEY=dein-geheimer-schluessel-hier-ersetzen

# ─── Lizenz ───────────────────────────────────────────────────────────────────
# Fester Hostname für die Lizenzbindung (machine_id). MUSS pro Installation stabil
# bleiben – sonst bricht die Aktivierung bei jedem Container-Update. Pro Kunde ggf.
# eindeutig setzen, z. B. datenmonster-kundexy.
LICENSE_HOSTNAME=datenmonster

# ─── Admin-Account ────────────────────────────────────────────────────────────
# Der Admin heisst immer "admin". ADMIN_PASSWORD setzt beim ersten Start sein
# Passwort; ein spaeter GEAENDERTER Wert setzt es zurueck (Notnagel).
ADMIN_PASSWORD=dein-admin-passwort-hier-ersetzen

# ─── Protokoll ────────────────────────────────────────────────────────────────
# DEBUG, INFO (Standard), WARNING, ERROR
LOG_LEVEL=INFO

# Datenbank und Upload-Verzeichnis legt docker-compose.yml fest (Volume
# datenmonster-data unter /app/uploads) – hier nicht einstellbar.
