          ],
          "sql": "WITH k(g, r, Reihe, Thema, Sort, Pct, Ziel) AS (VALUES\n    ('erzeugerpreise', 'GP19-1711', 'Holz- & Zellstoff', 'Rohstoffe', 1, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-17123', 'Wellpappenrohpapier', 'Rohstoffe', 2, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-383232', 'Altpapier (Sekundärrohstoff)', 'Rohstoffe', 3, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-2016', 'Kunststoffe in Primärformen', 'Rohstoffe', 4, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-1721', 'Wellpappe-Verpackungen', 'Einkaufspreise Verpackung', 5, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-172113', 'Kartons aus Wellpappe', 'Einkaufspreise Verpackung', 6, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-2222', 'Kunststoffverpackungen', 'Einkaufspreise Verpackung', 7, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-22213', 'Kunststofffolien & -platten', 'Einkaufspreise Verpackung', 8, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-244225', 'Alufolie & dünne Aluminiumbänder', 'Einkaufspreise Verpackung', 9, 1, 'erzeugerpreise'),\n    ('preise_grosshandel', 'WZ08-464', 'Großhandel Gebrauchs- & Verbrauchsgüter', 'Verkaufspreise', 10, 1, 'branchenvergleich'),\n    ('preise_grosshandel', 'WZ08-46494', 'Großhandel Papier & Pappe', 'Verkaufspreise', 11, 1, 'branchenvergleich'),\n    ('preise_grosshandel', 'WZ08-4676', 'Großhandel sonstige Halbwaren', 'Verkaufspreise', 12, 1, 'branchenvergleich'),\n    ('umsatz_handel_real', 'G46', 'Umsatz Großhandel insgesamt (real)', 'Nachfrage', 13, 1, 'branchenvergleich'),\n    ('umsatz_handel_real', 'G464', 'Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)', 'Nachfrage', 14, 1, 'branchenvergleich'),\n    ('umsatz_handel_real', 'G47_X_G473', 'Umsatz Einzelhandel (real)', 'Nachfrage', 15, 1, 'branchenvergleich'),\n    ('wechselkurse', 'USD', 'US-Dollar je Euro', 'Wechselkurse & Transport', 16, 1, 'waehrungen'),\n    ('wechselkurse', 'CNY', 'Chinesische Yuan je Euro', 'Wechselkurse & Transport', 17, 1, 'waehrungen'),\n    ('kraftstoff', 'Diesel', 'Diesel (€/l)', 'Wechselkurse & Transport', 18, 1, 'energie'),\n    ('insolvenzen', 'WZ08-46', 'Insolvenzen Großhandel', 'Insolvenzen', 19, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-47', 'Insolvenzen Einzelhandel', 'Insolvenzen', 20, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-17', 'Insolvenzen Papier- & Pappeherstellung', 'Insolvenzen', 21, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-22', 'Insolvenzen Kunststoffwaren', 'Insolvenzen', 22, 1, 'insolvenzen'),\n    ('stimmung', 'BS-ICI-BAL', 'Industrie-Vertrauen (Saldo)', 'Stimmung', 23, 0, 'stimmung'),\n    ('stimmung', 'BS-ESI-I', 'Wirtschaftsklima (ESI, Ø = 100)', 'Stimmung', 24, 0, 'stimmung')\n), s AS (\n    SELECT Groesse, Region, MAX(Periode) AS p FROM reihen WHERE Wert IS NOT NULL GROUP BY Groesse, Region\n)\nSELECT k.Thema, k.Reihe, a.Einheit,\n    substr(a.Periode, 6, 2) || '/' || substr(a.Periode, 1, 4) AS Stand,\n    ROUND(a.Wert, 2) AS Aktuell,\n    ROUND(v.Wert, 2) AS Vorjahr,\n    ROUND(a.Wert - v.Wert, 2) AS \"Veränderung\",\n    CASE WHEN k.Pct = 1 AND v.Wert <> 0 THEN ROUND(100.0 * (a.Wert - v.Wert) / v.Wert, 1) END AS \"Veränderung %\",\n    a.Quelle,\n    k.Ziel\nFROM k\nJOIN s ON s.Groesse = k.g AND s.Region = k.r\nJOIN reihen a ON a.Groesse = s.Groesse AND a.Region = s.Region AND a.Periode = s.p\nLEFT JOIN reihen v ON v.Groesse = a.Groesse AND v.Region = a.Region\n    AND v.Periode = (CAST(substr(a.Periode, 1, 4) AS INTEGER) - 1) || substr(a.Periode, 5)\nORDER BY k.Sort"
        }
