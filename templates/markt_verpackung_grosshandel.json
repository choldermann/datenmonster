          ],
          "sql": "SELECT Periode,\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-1711' THEN Wert END) AS \"Holz- & Zellstoff\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-17123' THEN Wert END) AS \"Wellpappenrohpapier\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-383232' THEN Wert END) AS \"Altpapier (Sekundärrohstoff)\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2016' THEN Wert END) AS \"Kunststoffe in Primärformen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-1721' THEN Wert END) AS \"Wellpappe-Verpackungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-172113' THEN Wert END) AS \"Kartons aus Wellpappe\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2222' THEN Wert END) AS \"Kunststoffverpackungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-22213' THEN Wert END) AS \"Kunststofffolien & -platten\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-244225' THEN Wert END) AS \"Alufolie & dünne Aluminiumbänder\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-464' THEN Wert END) AS \"Großhandel Gebrauchs- & Verbrauchsgüter\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46494' THEN Wert END) AS \"Großhandel Papier & Pappe\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-4676' THEN Wert END) AS \"Großhandel sonstige Halbwaren\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G46' THEN Wert END) AS \"Umsatz Großhandel insgesamt (real)\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G464' THEN Wert END) AS \"Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G47_X_G473' THEN Wert END) AS \"Umsatz Einzelhandel (real)\",\n    MAX(CASE WHEN Groesse = 'wechselkurse' AND Region = 'USD' THEN Wert END) AS \"US-Dollar je Euro\",\n    MAX(CASE WHEN Groesse = 'wechselkurse' AND Region = 'CNY' THEN Wert END) AS \"Chinesische Yuan je Euro\",\n    MAX(CASE WHEN Groesse = 'kraftstoff' AND Region = 'Diesel' THEN Wert END) AS \"Diesel (€/l)\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-46' THEN Wert END) AS \"Insolvenzen Großhandel\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-47' THEN Wert END) AS \"Insolvenzen Einzelhandel\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-17' THEN Wert END) AS \"Insolvenzen Papier- & Pappeherstellung\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-22' THEN Wert END) AS \"Insolvenzen Kunststoffwaren\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-ICI-BAL' THEN Wert END) AS \"Industrie-Vertrauen (Saldo)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-ESI-I' THEN Wert END) AS \"Wirtschaftsklima (ESI, Ø = 100)\"\nFROM reihen\nGROUP BY Periode\nORDER BY Periode"
        }
