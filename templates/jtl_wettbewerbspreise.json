{
 "format_version": "1.0",
 "template_id": "jtl_wettbewerbspreise",
 "template_name": "JTL – Wettbewerbspreise",
 "description": "Preise von Wettbewerbern automatisch abrufen und mit dem eigenen Verkaufspreis aus der JTL-Wawi vergleichen – mit Cockpit und Warnung, wenn der Wettbewerb deutlich günstiger ist.",
 "category": "jtl-reporting",
 "version": "1.2",
 "author": "Datenmonster",
 "hinweise": [
  "Voraussetzung: Datenmonster mit Stand ab 12.11.2026 (Web-Quelle mit Produktdaten, Preisabgleich und Wechselkursen). Vor dem Installieren die App aktualisieren – mit einem älteren Stand bleibt das Cockpit leer.",
  "Nach der Installation in Datasets „Wettbewerbspreise – URL-Liste“ öffnen und je Zeile ArtNr, Wettbewerber und die URL der Produktseite beim Wettbewerber eintragen.",
  "Dann beim Dataset „Wettbewerbspreise – Abruf“ auf „Jetzt abrufen“ klicken; danach unter Einstellungen → Zeitplan z.B. täglich 06:00 einstellen.",
  "Gelesen werden die Produktdaten, die Shops für Suchmaschinen mitliefern (Preis, Verfügbarkeit, EAN). Seiten ohne solche Daten liefern keinen Preis – dort in der Web-Quelle die Extraktion „KI“ wählen.",
  "Unser Preis = aktiver Sonderpreis der Standard-Kundengruppe, sonst Grundpreis (Preisliste.vPreislisteNetto, ohne Shop-Bezug, ab Menge 0) – jeweils zzgl. Inlands-MwSt. Normal- und Sonderpreis stehen getrennt in der Tabelle.",
  "Preise in Fremdwährung (z.B. USD, GBP, CHF) werden mit dem EZB-Monatsdurchschnitt in Euro umgerechnet; ohne erreichbaren Kurs bleibt der Vergleich für diese Angebote leer.",
  "Abrufe sind höflich eingestellt (1,5 s Pause, robots.txt). Nur öffentlich sichtbare Preise; viele große Shops sperren automatische Abrufe."
 ],
 "config_required": [
  {
   "key": "connection_jtl",
   "label": "JTL-Datenbankverbindung (MS SQL Server)",
   "type": "connection",
   "default": ""
  }
 ],
 "datasets": [
  {
   "id": "ds_urls",
   "name": "Wettbewerbspreise – URL-Liste",
   "file_type": "static",
   "columns": [
    "ArtNr",
    "Wettbewerber",
    "url"
   ],
   "initial_data": []
  },
  {
   "id": "ds_eigen",
   "name": "Wettbewerbspreise – eigene Preise (JTL)",
   "file_type": "db_query",
   "columns": [
    "ArtNr",
    "Artikel",
    "EAN",
    "VK_netto",
    "MwSt",
    "VK_brutto",
    "Sonderpreis_brutto",
    "Sonderpreis_bis",
    "Preis_aktuell_brutto",
    "EK_netto"
   ],
   "sql": "WITH zone AS (\n  SELECT TOP 1 kSteuerzone FROM dbo.tSteuerzoneLand WHERE cISO = 'DE'\n),\nstandard AS (\n  SELECT TOP 1 kKundenGruppe FROM dbo.tKundenGruppe WHERE nStandard = 1\n),\nsonder AS (\n  SELECT sp.kArtikel, MIN(sp.fNettoPreis) AS fNettoPreis, MIN(sp.dEnde) AS dEnde\n  FROM DbeS.vArtikelSonderpreis sp\n  WHERE sp.cAktiv = 'Y' AND sp.kShop = 0\n    AND sp.kKundenGruppe = (SELECT kKundenGruppe FROM standard)\n    AND (sp.nIstDatum = 0 OR (GETDATE() >= sp.dStart AND GETDATE() < DATEADD(DAY, 1, sp.dEnde)))\n    AND (sp.nIstAnzahl = 0 OR sp.nAnzahl > 0)\n  GROUP BY sp.kArtikel\n)\nSELECT a.cArtNr AS ArtNr,\n       ab.cName AS Artikel,\n       NULLIF(LTRIM(RTRIM(a.cBarcode)), '') AS EAN,\n       CAST(p.fNettoPreis AS DECIMAL(18,2)) AS VK_netto,\n       CAST(ISNULL(s.fSteuersatz, 0) AS DECIMAL(5,2)) AS MwSt,\n       CAST(p.fNettoPreis * (1 + ISNULL(s.fSteuersatz, 0) / 100.0) AS DECIMAL(18,2)) AS VK_brutto,\n       CAST(so.fNettoPreis * (1 + ISNULL(s.fSteuersatz, 0) / 100.0) AS DECIMAL(18,2)) AS Sonderpreis_brutto,\n       CASE WHEN so.kArtikel IS NOT NULL AND so.dEnde IS NOT NULL THEN CAST(so.dEnde AS date) END AS Sonderpreis_bis,\n       CAST(ISNULL(so.fNettoPreis, p.fNettoPreis) * (1 + ISNULL(s.fSteuersatz, 0) / 100.0) AS DECIMAL(18,2)) AS Preis_aktuell_brutto,\n       CAST(a.fEKNetto AS DECIMAL(18,2)) AS EK_netto\nFROM dbo.tArtikel a\nJOIN dbo.tArtikelBeschreibung ab\n  ON ab.kArtikel = a.kArtikel AND ab.kSprache = 1 AND ab.kPlattform = 1\nJOIN Preisliste.vPreislisteNetto p\n  ON p.kArtikel = a.kArtikel AND p.kShop = 0 AND p.nAnzahlAb = 0\n AND p.kKundenGruppe = (SELECT kKundenGruppe FROM standard)\nLEFT JOIN sonder so ON so.kArtikel = a.kArtikel\nLEFT JOIN dbo.tSteuersatz s\n  ON s.kSteuerklasse = a.kSteuerklasse AND s.kSteuerzone = (SELECT kSteuerzone FROM zone)\nWHERE a.cAktiv = 'Y'",
   "source_connection_id": "{{connection_jtl}}"
  },
