          ],
          "sql": "WITH k(g, r, Reihe, Thema, Sort, Pct, Ziel) AS (VALUES\n    ('erzeugerpreise', 'GP19-172114', 'Faltschachteln & Kartons (z. B. Pizzakartons)', 'Einkaufspreise Verpackung', 1, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-172112', 'Papiertüten & -beutel', 'Einkaufspreise Verpackung', 2, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-2222', 'Kunststoffverpackungen', 'Einkaufspreise Verpackung', 3, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-244225', 'Alufolie & dünne Aluminiumbänder', 'Einkaufspreise Verpackung', 4, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-222923', 'Kunststoffgeschirr & Hygieneartikel', 'Einkaufspreise Verpackung', 5, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-106121', 'Weizenmehl', 'Einkaufspreise Lebensmittel', 6, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-10514', 'Käse & Quark', 'Einkaufspreise Lebensmittel', 7, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-1041', 'Speiseöle & -fette', 'Einkaufspreise Lebensmittel', 8, 1, 'erzeugerpreise'),\n    ('preise_grosshandel', 'WZ08-463', 'Großhandel Nahrungs- & Genussmittel', 'Verkaufspreise', 9, 1, 'branchenvergleich'),\n    ('preise_grosshandel', 'WZ08-46494', 'Großhandel Papier & Pappe', 'Verkaufspreise', 10, 1, 'branchenvergleich'),\n    ('preise_verbraucher', 'Deutschland', 'Verbraucherpreise insgesamt', 'Verkaufspreise', 11, 1, 'branchenvergleich'),\n    ('umsatz_gastgewerbe', 'Deutschland', 'Umsatz Gastgewerbe (nominal)', 'Nachfrage', 12, 1, 'umfeld'),\n    ('umsatz_handel_real', 'G463', 'Umsatz Großhandel Nahrungsmittel (real)', 'Nachfrage', 13, 1, 'branchenvergleich'),\n    ('uebernachtungen', 'Deutschland', 'Übernachtungen Deutschland', 'Nachfrage', 14, 1, 'umfeld'),\n    ('kraftstoff', 'Diesel', 'Diesel (€/l)', 'Transportkosten', 15, 1, 'energie'),\n    ('insolvenzen', 'WZ08-561', 'Insolvenzen Restaurants & Imbisse', 'Insolvenzen der Kundenbranchen', 16, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-562', 'Insolvenzen Caterer', 'Insolvenzen der Kundenbranchen', 17, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-55', 'Insolvenzen Beherbergung', 'Insolvenzen der Kundenbranchen', 18, 1, 'insolvenzen'),\n    ('stimmung', 'BS-SCI-BAL', 'Dienstleister-Vertrauen (Saldo)', 'Stimmung', 19, 0, 'stimmung'),\n    ('stimmung', 'BS-CSMCI-BAL', 'Verbraucher-Vertrauen (Saldo)', 'Stimmung', 20, 0, 'stimmung')\n), s AS (\n    SELECT Groesse, Region, MAX(Periode) AS p FROM reihen WHERE Wert IS NOT NULL GROUP BY Groesse, Region\n)\nSELECT k.Thema, k.Reihe, a.Einheit,\n    substr(a.Periode, 6, 2) || '/' || substr(a.Periode, 1, 4) AS Stand,\n    ROUND(a.Wert, 2) AS Aktuell,\n    ROUND(v.Wert, 2) AS Vorjahr,\n    ROUND(a.Wert - v.Wert, 2) AS \"Veränderung\",\n    CASE WHEN k.Pct = 1 AND v.Wert <> 0 THEN ROUND(100.0 * (a.Wert - v.Wert) / v.Wert, 1) END AS \"Veränderung %\",\n    a.Quelle,\n    k.Ziel\nFROM k\nJOIN s ON s.Groesse = k.g AND s.Region = k.r\nJOIN reihen a ON a.Groesse = s.Groesse AND a.Region = s.Region AND a.Periode = s.p\nLEFT JOIN reihen v ON v.Groesse = a.Groesse AND v.Region = a.Region\n    AND v.Periode = (CAST(substr(a.Periode, 1, 4) AS INTEGER) - 1) || substr(a.Periode, 5)\nORDER BY k.Sort"
        }
      ],
