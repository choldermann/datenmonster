            "Verbraucher-Vertrauen (Saldo)"
          ],
          "sql": "SELECT Periode,\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-172114' THEN Wert END) AS \"Faltschachteln & Kartons (z. B. Pizzakartons)\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-172112' THEN Wert END) AS \"Papiertüten & -beutel\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2222' THEN Wert END) AS \"Kunststoffverpackungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-244225' THEN Wert END) AS \"Alufolie & dünne Aluminiumbänder\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-222923' THEN Wert END) AS \"Kunststoffgeschirr & Hygieneartikel\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-106121' THEN Wert END) AS \"Weizenmehl\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-10514' THEN Wert END) AS \"Käse & Quark\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-1041' THEN Wert END) AS \"Speiseöle & -fette\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-463' THEN Wert END) AS \"Großhandel Nahrungs- & Genussmittel\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46494' THEN Wert END) AS \"Großhandel Papier & Pappe\",\n    MAX(CASE WHEN Groesse = 'preise_verbraucher' AND Region = 'Deutschland' THEN Wert END) AS \"Verbraucherpreise insgesamt\",\n    MAX(CASE WHEN Groesse = 'umsatz_gastgewerbe' AND Region = 'Deutschland' THEN Wert END) AS \"Umsatz Gastgewerbe (nominal)\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G463' THEN Wert END) AS \"Umsatz Großhandel Nahrungsmittel (real)\",\n    MAX(CASE WHEN Groesse = 'uebernachtungen' AND Region = 'Deutschland' THEN Wert END) AS \"Übernachtungen Deutschland\",\n    MAX(CASE WHEN Groesse = 'kraftstoff' AND Region = 'Diesel' THEN Wert END) AS \"Diesel (€/l)\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-561' THEN Wert END) AS \"Insolvenzen Restaurants & Imbisse\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-562' THEN Wert END) AS \"Insolvenzen Caterer\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-55' THEN Wert END) AS \"Insolvenzen Beherbergung\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-SCI-BAL' THEN Wert END) AS \"Dienstleister-Vertrauen (Saldo)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-CSMCI-BAL' THEN Wert END) AS \"Verbraucher-Vertrauen (Saldo)\"\nFROM reihen\nGROUP BY Periode\nORDER BY Periode"
        }
