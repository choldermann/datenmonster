    {
      "id": "mapping_altware_tabelle",
      "name": "Altware / Ladenhüter",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT TOP 300\n    A.cArtNr AS ArtNr,\n    AB.cName AS Artikel,\n    ISNULL(WG.cName, '') AS Warengruppe,\n    CAST(B.Bestand AS DECIMAL(18,2)) AS Bestand,\n    CAST(ISNULL(A.fEKNetto, 0) AS DECIMAL(18,2)) AS EK,\n    CAST(B.Bestand * ISNULL(A.fEKNetto, 0) AS DECIMAL(18,2)) AS Kapitalbindung,\n    CONVERT(char(10), LV.LetzterVerkauf, 104) AS LetzterVerkauf,\n    ISNULL(DATEDIFF(DAY, LV.LetzterVerkauf, GETDATE()), 9999) AS TageOhneVerkauf\nFROM dbo.tArtikel A\nCROSS APPLY (SELECT ISNULL(SUM(fLagerbestand), 0) AS Bestand FROM dbo.tlagerbestand WHERE kArtikel = A.kArtikel) B\nOUTER APPLY (\n    SELECT MAX(RE.dErstellt) AS LetzterVerkauf\n    FROM Rechnung.vRechnung RE\n    JOIN Rechnung.tRechnungPosition POS ON POS.kRechnung = RE.kRechnung\n    WHERE POS.cArtNr = A.cArtNr\n) LV\nLEFT JOIN dbo.tWarengruppe WG ON WG.kWarengruppe = A.kWarengruppe\nLEFT JOIN dbo.tArtikelBeschreibung AB ON AB.kArtikel = A.kArtikel AND AB.kSprache = 1 AND AB.kPlattform = 1 AND AB.kShop = 0\nWHERE B.Bestand > 0\n    AND (LV.LetzterVerkauf IS NULL OR LV.LetzterVerkauf < DATEADD(DAY, -{{ladenhueter_tage}}, GETDATE()))\n    AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\nORDER BY Kapitalbindung DESC",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "ArtNr",
            "Artikel",
            "Warengruppe",
            "Bestand",
            "EK",
            "Kapitalbindung",
            "LetzterVerkauf",
            "TageOhneVerkauf"
          ]
        }
