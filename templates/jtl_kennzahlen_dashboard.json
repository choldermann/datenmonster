    {
      "id": "mapping_umsatz_verlauf",
      "name": "Umsatz-Verlauf",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "WITH cur AS (\n    SELECT CONVERT(char(7), RE.dErstellt, 120) AS Monat,\n           SUM(POS.fAnzahl * POS.fVkNetto) AS Umsatz\n    FROM Rechnung.vRechnung RE\n    JOIN Rechnung.tRechnungPosition POS ON POS.kRechnung = RE.kRechnung\n    LEFT JOIN dbo.tArtikel A ON A.cArtNr = POS.cArtNr\n    WHERE RE.dErstellt >= :von AND RE.dErstellt < DATEADD(DAY, 1, :bis) AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\n    GROUP BY CONVERT(char(7), RE.dErstellt, 120)\n),\nvj AS (\n    SELECT CONVERT(char(7), DATEADD(YEAR, 1, RE.dErstellt), 120) AS Monat,\n           SUM(POS.fAnzahl * POS.fVkNetto) AS UmsatzVorjahr\n    FROM Rechnung.vRechnung RE\n    JOIN Rechnung.tRechnungPosition POS ON POS.kRechnung = RE.kRechnung\n    LEFT JOIN dbo.tArtikel A ON A.cArtNr = POS.cArtNr\n    WHERE RE.dErstellt >= DATEADD(YEAR,-1,:von) AND RE.dErstellt < DATEADD(DAY,1,DATEADD(YEAR,-1,:bis)) AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\n    GROUP BY CONVERT(char(7), DATEADD(YEAR, 1, RE.dErstellt), 120)\n)\nSELECT ISNULL(cur.Monat, vj.Monat) AS Monat,\n       CAST(ISNULL(cur.Umsatz, 0) AS DECIMAL(18,2)) AS Umsatz,\n       CAST(ISNULL(vj.UmsatzVorjahr, 0) AS DECIMAL(18,2)) AS UmsatzVorjahr\nFROM cur FULL OUTER JOIN vj ON cur.Monat = vj.Monat\nORDER BY Monat",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "Monat",
            "Umsatz",
            "UmsatzVorjahr"
          ]
        }
      ],
