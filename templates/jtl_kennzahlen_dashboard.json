    {
      "id": "mapping_lager_kpi",
      "name": "Lager-Kennzahlen",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT\n    CAST(SUM(LB.fLagerbestand * ISNULL(A.fEKNetto, 0)) AS DECIMAL(18,2)) AS Kapitalbindung,\n    COUNT(DISTINCT CASE WHEN LB.fLagerbestand > 0 THEN A.kArtikel END) AS ArtikelMitBestand,\n    CAST(SUM(LB.fLagerbestand) AS DECIMAL(18,2)) AS Gesamtmenge\nFROM dbo.tArtikel A\nJOIN dbo.tlagerbestand LB ON LB.kArtikel = A.kArtikel\nWHERE (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "Kapitalbindung",
            "ArtikelMitBestand",
            "Gesamtmenge"
          ]
