    {
      "id": "mapping_umsatz_auftraege",
      "name": "Aufträge im Zeitraum",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT TOP 500\n    RE.cRechnungsnr AS Rechnung,\n    CONVERT(char(10), RE.dErstellt, 104) AS Datum,\n    ISNULL(RE.cFirma, RE.cName) AS Kunde,\n    COUNT(POS.kRechnungPosition) AS Positionen,\n    CAST(SUM(POS.fAnzahl * POS.fVkNetto) AS DECIMAL(18,2)) AS UmsatzNetto\nFROM Rechnung.vRechnung RE\nJOIN Rechnung.tRechnungPosition POS ON POS.kRechnung = RE.kRechnung\nLEFT JOIN dbo.tArtikel A ON A.cArtNr = POS.cArtNr\nWHERE RE.dErstellt >= :von AND RE.dErstellt < DATEADD(DAY, 1, :bis) AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\nGROUP BY RE.cRechnungsnr, CONVERT(char(10), RE.dErstellt, 104), ISNULL(RE.cFirma, RE.cName), RE.dErstellt\nORDER BY RE.dErstellt DESC",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "Rechnung",
            "Datum",
            "Kunde",
            "Positionen",
            "UmsatzNetto"
          ]
        }
      ],
