    {
      "id": "mapping_kapital_wg",
      "name": "Kapitalbindung nach Warengruppe",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT TOP 15\n    ISNULL(WG.cName, '(ohne Warengruppe)') AS Warengruppe,\n    CAST(SUM(LB.fLagerbestand * ISNULL(A.fEKNetto, 0)) AS DECIMAL(18,2)) AS Kapitalbindung\nFROM dbo.tArtikel A\nJOIN dbo.tlagerbestand LB ON LB.kArtikel = A.kArtikel\nLEFT JOIN dbo.tWarengruppe WG ON WG.kWarengruppe = A.kWarengruppe\nWHERE (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\nGROUP BY ISNULL(WG.cName, '(ohne Warengruppe)')\nORDER BY Kapitalbindung DESC",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "Warengruppe",
            "Kapitalbindung"
          ]
        }
      ],
