    {
      "id": "mapping_altware_kpi",
      "name": "Altware-Kennzahlen",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT\n    CAST(SUM(B.Bestand * ISNULL(A.fEKNetto, 0)) AS DECIMAL(18,2)) AS GebundenesKapital,\n    COUNT(*) AS AnzahlLadenhueter\nFROM dbo.tArtikel A\nCROSS APPLY (SELECT ISNULL(SUM(fLagerbestand), 0) AS Bestand FROM dbo.tlagerbestand WHERE kArtikel = A.kArtikel) B\nOUTER APPLY (\n    SELECT MAX(RE.dErstellt) AS LetzterVerkauf\n    FROM Rechnung.vRechnung RE\n    JOIN Rechnung.tRechnungPosition POS ON POS.kRechnung = RE.kRechnung\n    WHERE POS.cArtNr = A.cArtNr\n) LV\nLEFT JOIN dbo.tWarengruppe WG ON WG.kWarengruppe = A.kWarengruppe\nWHERE B.Bestand > 0\n    AND (LV.LetzterVerkauf IS NULL OR LV.LetzterVerkauf < DATEADD(DAY, -{{ladenhueter_tage}}, GETDATE()))\n    AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "GebundenesKapital",
            "AnzahlLadenhueter"
          ]
        }
      ],
