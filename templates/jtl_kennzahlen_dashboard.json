    {
      "id": "mapping_lager_tabelle",
      "name": "Lagerbestand je Artikel",
      "canvas_nodes": [],
      "joins": [],
      "sql_nodes": [
        {
          "id": "sql1",
          "x": 120,
          "y": 40,
          "width": 380,
          "height": 260,
          "connection_id": "{{connection_jtl}}",
          "sql": "SELECT TOP 300\n    A.cArtNr AS ArtNr,\n    AB.cName AS Artikel,\n    ISNULL(WG.cName, '') AS Warengruppe,\n    CAST(LB.fLagerbestand AS DECIMAL(18,2)) AS Bestand,\n    CAST(ISNULL(A.fEKNetto, 0) AS DECIMAL(18,2)) AS EK,\n    CAST(LB.fLagerbestand * ISNULL(A.fEKNetto, 0) AS DECIMAL(18,2)) AS Kapitalbindung\nFROM dbo.tArtikel A\nJOIN dbo.tlagerbestand LB ON LB.kArtikel = A.kArtikel\nLEFT JOIN dbo.tWarengruppe WG ON WG.kWarengruppe = A.kWarengruppe\nLEFT JOIN dbo.tArtikelBeschreibung AB ON AB.kArtikel = A.kArtikel AND AB.kSprache = 1 AND AB.kPlattform = 1 AND AB.kShop = 0\nWHERE LB.fLagerbestand <> 0 AND (NULLIF(:kwarengruppe,'') IS NULL OR A.kWarengruppe = CAST(NULLIF(:kwarengruppe,'') AS INT))\nORDER BY Kapitalbindung DESC",
          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "ArtNr",
            "Artikel",
            "Warengruppe",
            "Bestand",
            "EK",
            "Kapitalbindung"
          ]
        }
      ],
