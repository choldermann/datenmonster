            "Temperatur Deutschland (°C)"
          ],
          "sql": "SELECT Periode,\n    MAX(CASE WHEN Groesse = 'umsatz_handel_ka' AND Region = 'G4791' THEN Wert END) AS \"Versand- & Internethandel (nominal)\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real_ka' AND Region = 'G4791' THEN Wert END) AS \"Versand- & Internethandel (real)\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real_ka' AND Region = 'G47_NFOOD_X_G473' THEN Wert END) AS \"Einzelhandel ohne Lebensmittel (real)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-CSMCI-BAL' THEN Wert END) AS \"Verbraucher-Vertrauen (Saldo)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-RCI-BAL' THEN Wert END) AS \"Einzelhandel-Vertrauen (Saldo)\",\n    MAX(CASE WHEN Groesse = 'preise_verbraucher' AND Region = 'Deutschland' THEN Wert END) AS \"Verbraucherpreise insgesamt\",\n    MAX(CASE WHEN Groesse = 'wechselkurse' AND Region = 'USD' THEN Wert END) AS \"US-Dollar je Euro\",\n    MAX(CASE WHEN Groesse = 'wechselkurse' AND Region = 'CNY' THEN Wert END) AS \"Chinesische Yuan je Euro\",\n    MAX(CASE WHEN Groesse = 'kraftstoff' AND Region = 'Diesel' THEN Wert END) AS \"Diesel (€/l)\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-4791' THEN Wert END) AS \"Insolvenzen Versand- & Internethandel\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-47' THEN Wert END) AS \"Insolvenzen Einzelhandel gesamt\",\n    MAX(CASE WHEN Groesse = 'temperatur' AND Region = 'Deutschland' THEN Wert END) AS \"Temperatur Deutschland (°C)\"\nFROM reihen\nGROUP BY Periode\nORDER BY Periode"
        }
      ],
