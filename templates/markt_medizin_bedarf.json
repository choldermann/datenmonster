          ],
          "sql": "WITH k(g, r, Reihe, Thema, Sort, Pct, Ziel) AS (VALUES\n    ('erzeugerpreise', 'GP19-325', 'Medizinische & zahnmed. Apparate und Materialien', 'Einkaufspreise der Hersteller', 1, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-325013', 'Spritzen, Kanülen, Katheter', 'Einkaufspreise der Hersteller', 2, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-325050', 'Andere Waren für medizinische Zwecke', 'Einkaufspreise der Hersteller', 3, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-2120', 'Arzneimittel (pharmazeutische Spezialitäten)', 'Einkaufspreise der Hersteller', 4, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-202014', 'Desinfektionsmittel', 'Einkaufspreise der Hersteller', 5, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-329911', 'Schutzhandschuhe & -kopfbedeckungen', 'Einkaufspreise der Hersteller', 6, 1, 'erzeugerpreise'),\n    ('erzeugerpreise', 'GP19-172211', 'Hygienepapier (Toilettenpapier, Handtücher)', 'Einkaufspreise der Hersteller', 7, 1, 'erzeugerpreise'),\n    ('preise_grosshandel', 'WZ08-46462', 'Großhandel Medizin-, Dental- & Laborbedarf', 'Verkaufspreise', 8, 1, 'branchenvergleich'),\n    ('preise_grosshandel', 'WZ08-46461', 'Großhandel Arzneimittel', 'Verkaufspreise', 9, 1, 'branchenvergleich'),\n    ('preise_verbraucher', 'Deutschland', 'Verbraucherpreise insgesamt', 'Verkaufspreise', 10, 1, 'branchenvergleich'),\n    ('umsatz_handel_real', 'G464', 'Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)', 'Nachfrage', 11, 1, 'branchenvergleich'),\n    ('kraftstoff', 'Diesel', 'Diesel (€/l)', 'Transportkosten', 12, 1, 'energie'),\n    ('insolvenzen', 'WZ08-862', 'Insolvenzen Arzt- & Zahnarztpraxen', 'Insolvenzen der Kundenbranchen', 13, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-861', 'Insolvenzen Krankenhäuser', 'Insolvenzen der Kundenbranchen', 14, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-871', 'Insolvenzen Pflegeheime', 'Insolvenzen der Kundenbranchen', 15, 1, 'insolvenzen'),\n    ('insolvenzen', 'WZ08-75', 'Insolvenzen Veterinärwesen', 'Insolvenzen der Kundenbranchen', 16, 1, 'insolvenzen'),\n    ('stimmung', 'BS-SCI-BAL', 'Dienstleister-Vertrauen (Saldo)', 'Stimmung', 17, 0, 'stimmung'),\n    ('stimmung', 'BS-ESI-I', 'Wirtschaftsklima (ESI, Ø = 100)', 'Wirtschaftsklima (Ø = 100)', 18, 0, 'stimmung')\n), s AS (\n    SELECT Groesse, Region, MAX(Periode) AS p FROM reihen WHERE Wert IS NOT NULL GROUP BY Groesse, Region\n)\nSELECT k.Thema, k.Reihe, a.Einheit,\n    substr(a.Periode, 6, 2) || '/' || substr(a.Periode, 1, 4) AS Stand,\n    ROUND(a.Wert, 2) AS Aktuell,\n    ROUND(v.Wert, 2) AS Vorjahr,\n    ROUND(a.Wert - v.Wert, 2) AS \"Veränderung\",\n    CASE WHEN k.Pct = 1 AND v.Wert <> 0 THEN ROUND(100.0 * (a.Wert - v.Wert) / v.Wert, 1) END AS \"Veränderung %\",\n    a.Quelle,\n    k.Ziel\nFROM k\nJOIN s ON s.Groesse = k.g AND s.Region = k.r\nJOIN reihen a ON a.Groesse = s.Groesse AND a.Region = s.Region AND a.Periode = s.p\nLEFT JOIN reihen v ON v.Groesse = a.Groesse AND v.Region = a.Region\n    AND v.Periode = (CAST(substr(a.Periode, 1, 4) AS INTEGER) - 1) || substr(a.Periode, 5)\nORDER BY k.Sort"
        }
      ],
