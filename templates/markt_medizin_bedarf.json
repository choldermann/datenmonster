            "Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)",
            "Diesel (€/l)",
            "Insolvenzen Arzt- & Zahnarztpraxen",
            "Insolvenzen Krankenhäuser",
            "Insolvenzen Pflegeheime",
            "Insolvenzen Veterinärwesen",
            "Dienstleister-Vertrauen (Saldo)",
            "Wirtschaftsklima (ESI, Ø = 100)"
          ],
          "sql": "SELECT Periode,\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-325' THEN Wert END) AS \"Medizinische & zahnmed. Apparate und Materialien\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-325013' THEN Wert END) AS \"Spritzen, Kanülen, Katheter\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-325050' THEN Wert END) AS \"Andere Waren für medizinische Zwecke\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2120' THEN Wert END) AS \"Arzneimittel (pharmazeutische Spezialitäten)\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-202014' THEN Wert END) AS \"Desinfektionsmittel\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-329911' THEN Wert END) AS \"Schutzhandschuhe & -kopfbedeckungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-172211' THEN Wert END) AS \"Hygienepapier (Toilettenpapier, Handtücher)\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46462' THEN Wert END) AS \"Großhandel Medizin-, Dental- & Laborbedarf\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46461' THEN Wert END) AS \"Großhandel Arzneimittel\",\n    MAX(CASE WHEN Groesse = 'preise_verbraucher' AND Region = 'Deutschland' THEN Wert END) AS \"Verbraucherpreise insgesamt\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G464' THEN Wert END) AS \"Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)\",\n    MAX(CASE WHEN Groesse = 'kraftstoff' AND Region = 'Diesel' THEN Wert END) AS \"Diesel (€/l)\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-862' THEN Wert END) AS \"Insolvenzen Arzt- & Zahnarztpraxen\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-861' THEN Wert END) AS \"Insolvenzen Krankenhäuser\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-871' THEN Wert END) AS \"Insolvenzen Pflegeheime\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-75' THEN Wert END) AS \"Insolvenzen Veterinärwesen\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-SCI-BAL' THEN Wert END) AS \"Dienstleister-Vertrauen (Saldo)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-ESI-I' THEN Wert END) AS \"Wirtschaftsklima (ESI, Ø = 100)\"\nFROM reihen\nGROUP BY Periode\nORDER BY Periode"
        }
