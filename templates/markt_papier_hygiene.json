            "Insolvenzen Gesundheitswesen & Heime",
            "Wirtschaftsklima (ESI, Ø = 100)",
            "Dienstleister-Vertrauen (Saldo)"
          ],
          "sql": "SELECT Periode,\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-172211' THEN Wert END) AS \"Hygienepapier (Toilettenpapier, Handtücher)\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-1721' THEN Wert END) AS \"Wellpappe-Verpackungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2222' THEN Wert END) AS \"Kunststoffverpackungen\",\n    MAX(CASE WHEN Groesse = 'erzeugerpreise' AND Region = 'GP19-2041' THEN Wert END) AS \"Seifen, Wasch- & Reinigungsmittel\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46494' THEN Wert END) AS \"Großhandel Papier & Bürobedarf\",\n    MAX(CASE WHEN Groesse = 'preise_grosshandel' AND Region = 'WZ08-46442' THEN Wert END) AS \"Großhandel Wasch- & Reinigungsmittel\",\n    MAX(CASE WHEN Groesse = 'preise_verbraucher' AND Region = 'Deutschland' THEN Wert END) AS \"Verbraucherpreise insgesamt\",\n    MAX(CASE WHEN Groesse = 'umsatz_handel_real' AND Region = 'G464' THEN Wert END) AS \"Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)\",\n    MAX(CASE WHEN Groesse = 'umsatz_gastgewerbe' AND Region = 'Deutschland' THEN Wert END) AS \"Umsatz Gastgewerbe (nominal)\",\n    MAX(CASE WHEN Groesse = 'kraftstoff' AND Region = 'Diesel' THEN Wert END) AS \"Diesel (€/l)\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-56' THEN Wert END) AS \"Insolvenzen Gastronomie\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-55' THEN Wert END) AS \"Insolvenzen Beherbergung\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-812' THEN Wert END) AS \"Insolvenzen Gebäudereinigung\",\n    MAX(CASE WHEN Groesse = 'insolvenzen' AND Region = 'WZ08-86' THEN Wert END) AS \"Insolvenzen Gesundheitswesen & Heime\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-ESI-I' THEN Wert END) AS \"Wirtschaftsklima (ESI, Ø = 100)\",\n    MAX(CASE WHEN Groesse = 'stimmung' AND Region = 'BS-SCI-BAL' THEN Wert END) AS \"Dienstleister-Vertrauen (Saldo)\"\nFROM reihen\nGROUP BY Periode\nORDER BY Periode"
        }
      ],
