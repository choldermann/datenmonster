          "mode": "transform",
          "output_field": "sql_1",
          "output_fields": [
            "Periode",
            "Hygienepapier (Toilettenpapier, Handtücher)",
            "Wellpappe-Verpackungen",
            "Kunststoffverpackungen",
            "Seifen, Wasch- & Reinigungsmittel",
            "Großhandel Papier & Bürobedarf",
            "Großhandel Wasch- & Reinigungsmittel",
            "Verbraucherpreise insgesamt",
            "Umsatz Großhandel Gebrauchs- & Verbrauchsgüter (real)",
            "Umsatz Gastgewerbe (nominal)",
            "Diesel (€/l)",
            "Insolvenzen Gastronomie",
